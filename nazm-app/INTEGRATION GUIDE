### الخطوة 3: تحديث NazmFullSystem.jsx

استبدل الـ sections بـ المكونات الجديدة:

#### Import الملفات الجديدة:

```javascript
import { HomeDashboard } from './components/HomeDashboard';
import { AIChat } from './components/AIChat';
import { ResponsiveLayout, MobileContainer } from './components/ResponsiveLayout';
import { usePersist, useTasks, useChatHistory } from './hooks/usePersistence';
import { useElectronAPI } from './hooks/useElectron';
```

#### استبدل HomeSection:

```javascript
function HomeSection({ T, isRtl }) {
  return <HomeDashboard T={T} isRtl={isRtl} />;
}
```

#### استبدل AISection:

```javascript
function AISection({ T, isRtl }) {
  return <AIChat T={T} isRtl={isRtl} />;
}
```

#### استبدل DashboardLayout:

```javascript
function DashboardLayout({ T, isRtl, children }) {
  return (
    <ResponsiveLayout
      T={T}
      isRtl={isRtl}
      sidebar={<Sidebar T={T} isRtl={isRtl} />}
    >
      {children}
    </ResponsiveLayout>
  );
}
```

