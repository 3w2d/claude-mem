  </div>

  {/* Input Form */}
  <form onSubmit={handleSend} className="flex gap-2">
    <input
      type="text"
      value={input}
      onChange={(e) => setInput(e.target.value)}
      placeholder={isRtl ? 'اكتب سؤالك…' : 'Type your question…'}
