          isUser={msg.role === 'user'}
        />
      ))
    )}

    {thinking && (
      <div className="flex justify-start">
        <div className={`px-4 py-3 rounded-2xl text-sm ${T.chipMuted}`}>
          <ThinkingDots isRtl={isRtl} />
        </div>
      </div>
    )}
  </div>

  {/* Suggestions */}
  <div className="flex flex-wrap gap-2 mb-4">
