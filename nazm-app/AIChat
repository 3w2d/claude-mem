);
}

/**

- Individual Chat Message Component
  */
  function ChatMessage({ message, T, isRtl, isUser }) {
  const isAssistant = !isUser;
  return (
  
   <div className={`flex ${isUser ? 'justify-end' : 'justify-start'}`}>
     <div
       className={`max-w-[85%] px-4 py-3 rounded-2xl text-sm leading-relaxed ${
         isUser
           ? 'bg-[#8B5CF6] text-white'
           : `${T.chipMuted}`
       }`}
     >
       {message.text}
       <div className={`text-[10px] mt-1 ${isUser ? 'opacity-70' : T.textFaint}`}>
         {new Date(message.timestamp).toLocaleTimeString(isRtl ? 'ar-SA' : 'en-US', {
           hour: '2-digit',
           minute: '2-digit',
         })}
       </div>
     </div>
   </div>

);
}

/**

- Thinking Animation Component
  */
  function ThinkingDots({ isRtl }) {
  return (
  
   <div className="flex items-center gap-1">
     <span className="animate-bounce" style={{ animationDelay: '0ms' }}>•</span>
     <span className="animate-bounce" style={{ animationDelay: '150ms' }}>•</span>
     <span className="animate-bounce" style={{ animationDelay: '300ms' }}>•</span>
     <span className="ms-2 text-sm">{isRtl ? 'يفكر…' : 'Thinking…'}</span>
   </div>

);
}