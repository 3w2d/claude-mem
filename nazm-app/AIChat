import React, { useState, useEffect, useRef } from ‘react’;
import { Brain, Send, Trash2, Clock, MessageCircle } from ‘lucide-react’;
import { useChatHistory, useStats } from ‘../hooks/usePersistence’;
import { ask } from ‘../lib/aiMock’;

/**

- Enhanced AI Chat Component with History Persistence
  */
  export function AIChat({ T, isRtl }) {
  const { messages, addMessage, clearHistory } = useChatHistory();
  const { increment } = useStats();
  const [input, setInput] = useState(’’);
  const [thinking, setThinking] = useState(false);
  const listRef = useRef(null);

// Auto-scroll to latest message
useEffect(() => {
if (listRef.current) {
listRef.current.scrollTop = listRef.current.scrollHeight;
}
}, [messages, thinking]);

const suggestions = isRtl
? [‘هل يوجد تداخل في المواعيد؟’, ‘ملخص المطالبات’, ‘حالة المكاتب’, ‘نصائح الإنتاجية’]
: [‘Any scheduling conflicts?’, ‘Claims summary’, ‘Office status’, ‘Productivity tips’];

const handleSend = async (e) => {
e?.preventDefault();
const text = input.trim();
if (!text || thinking) return;

```
// Add user message
setInput('');
addMessage('user', text);
increment('messagesExchanged');

// Get AI response
setThinking(true);
try {
  const reply = await ask(text, { isRtl });
  addMessage('assistant', reply);
  increment('messagesExchanged');
} catch (error) {
  addMessage('assistant', isRtl
    ? 'عذراً، حدث خطأ. يرجى المحاولة مرة أخرى.'
    : 'Sorry, an error occurred. Please try again.');
} finally {
  setThinking(false);
}
