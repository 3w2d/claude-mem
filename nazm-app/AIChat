};

const handleSuggestion = (suggestion) => {
setInput(suggestion);
};

return (
<div className={`p-8 rounded-[40px] border ${T.surface} flex flex-col`} style={{ minHeight: 600 }}>
{/* Header */}
<div className=“flex items-center justify-between mb-6 pb-4 border-b” style={{ borderColor: ‘rgba(139, 92, 246, 0.1)’ }}>
<div className="flex items-center gap-3">
<Brain className="text-[#8B5CF6] animate-pulse" size={28} />
<div>
<h2 className={`text-2xl font-black ${T.textMain}`}>
{isRtl ? ‘المساعد الذكي’ : ‘AI Assistant’}
</h2>
<p className={`text-[11px] ${T.textFaint}`}>
{isRtl ? ‘نَظْم ذكي متعدد الوظائف’ : ‘Multi-functional smart assistant’}
</p>
</div>
</div>
{messages.length > 0 && (
<button
type=“button”
onClick={() => {
if (confirm(isRtl ? ‘هل تريد مسح السجل؟’ : ‘Clear chat history?’)) {
clearHistory();
}
}}
className=“text-red-500/60 hover:text-red-500 p-2 rounded-lg transition”
title={isRtl ? ‘مسح السجل’ : ‘Clear history’}
>
<Trash2 size={18} />
</button>
)}
</div>

```
  {/* Messages Container */}
  <div
    ref={listRef}
    className={`flex-1 overflow-y-auto space-y-4 mb-4 pr-2`}
    style={{ maxHeight: 400 }}
  >
    {messages.length === 0 ? (
      <div className="h-full flex items-center justify-center text-center">
        <div>
          <MessageCircle size={48} className="mx-auto mb-4 opacity-20" />
          <p className={`text-sm ${T.textFaint}`}>
            {isRtl ? 'ابدأ محادثة مع نَظْم…' : 'Start a conversation with Nazm…'}
          </p>
        </div>
      </div>
    ) : (
      messages.map((msg) => (
        <ChatMessage
          key={msg.id}
          message={msg}
          T={T}
