{
  "expo": {
    "name": "رَكيزة",
    "slug": "rakiza-app",
    "scheme": "rakiza",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fcfcfd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.claude.rakiza",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "رَكيزة تستخدم الإشعارات لتذكيرك بمهام مشروعك في أنسب وقت."
      }
    },
    "android": {
      "package": "ai.claude.rakiza",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0056f7"
      },
      "permissions": ["NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#0056f7" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
