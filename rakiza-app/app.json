{
  "expo": {
    "name": "ركيزة",
    "slug": "rakiza-app",
    "scheme": "rakiza",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.claude.rakiza"
    },
    "android": {
      "package": "ai.claude.rakiza",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a10"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/claude-mem/rakiza-web"
    }
  }
}
