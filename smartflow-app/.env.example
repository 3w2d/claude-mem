# ============================================================
# SmartFlow v3 — environment variables
# Copy to `.env.local` and fill in the values you want to enable.
# Every integration is opt-in; missing values fall back gracefully.
# ============================================================

# --- Supabase (optional) -----------------------------------
# Persist files/events/tasks/ai history in Supabase instead of localStorage.
# Apply the schema in `supabase/schema.sql` once, then set:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Microsoft 365 / Graph (optional) ----------------------
# Register an app at https://portal.azure.com (Azure AD → App registrations)
# with redirect URI http://localhost:5173 for dev.
# Scopes requested: User.Read, Calendars.Read, Files.Read.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# --- OpenAI (optional) -------------------------------------
# When enabled, the AI Assistant proxies to OpenAI via /api/chat.
# The key is used server-side only; never exposed to the browser.
VITE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
